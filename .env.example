# ==============================================================================
# FluxV2X Environment Configuration Template
# Copy this file to `.env` and configure appropriate values for your environment.
# In PRODUCTION, the application will FAIL TO START if weak or default secrets are detected.
# ==============================================================================

PROJECT_NAME="FluxV2X"
ENVIRONMENT="development"  # Options: "development", "staging", "production"
DEBUG=false                # Must be false in production

# Cryptographic Signing Secret
# In production, generate using: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters and cryptographically random.
SECRET_KEY="generate_and_insert_cryptographically_secure_random_key_here_32_bytes_min"

API_V1_STR="/api/v1"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence
# Local Development (SQLite):
DATABASE_URL="sqlite:///./fluxv2x.db"
# Production (PostgreSQL):
# POSTGRES_USER=fluxv2x_user
# POSTGRES_PASSWORD=replace_with_strong_database_password
# POSTGRES_DB=fluxv2x_db
# DATABASE_URL="postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"

# Background Job Queue (Redis)
REDIS_URL="redis://localhost:6379/0"

# Storage Directories
LOCAL_STORAGE_PATH="../data/uploads"
DERIVED_STORAGE_PATH="../data/derived"
ARTIFACTS_STORAGE_PATH="../artifacts"

# Upload and Security Controls
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB max upload
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Research Integrity & Data Provisioning Flags
# AUTO_LOAD_DEMO_DATASET: If true, provisions an explicitly labeled synthetic fixture for development testing.
# For security and research integrity, this MUST be false in production.
AUTO_LOAD_DEMO_DATASET=false

# ENABLE_DEV_BOOTSTRAP: If true, provisions a local dev researcher account for workstation testing.
# FORBIDDEN in production (application fails startup if enabled when ENVIRONMENT=production).
ENABLE_DEV_BOOTSTRAP=false
