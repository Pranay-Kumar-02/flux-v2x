# FluxV2X Environment Configuration Template
PROJECT_NAME="FluxV2X"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="change-me-to-a-secure-random-secret-in-production"
API_V1_STR="/api/v1"

# Database
# For local development: SQLite (default fallback)
DATABASE_URL="sqlite:///./fluxv2x.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://fluxv2x_user:fluxv2x_pass@localhost:5432/fluxv2x_db"

# Redis & Background Tasks
REDIS_URL="redis://localhost:6379/0"
ASYNC_PROCESSING_MODE="in_process" # options: "in_process" (standalone threadpool worker) or "celery"

# Storage
STORAGE_BACKEND="local" # options: "local" or "s3"
LOCAL_STORAGE_PATH="../data/uploads"
DERIVED_STORAGE_PATH="../data/derived"
ARTIFACTS_STORAGE_PATH="../artifacts"

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo / Public Dataset Auto-Provisioning
AUTO_LOAD_DEMO_DATASET=true
